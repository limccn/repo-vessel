{
  "name": "repo-vessel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "码之灵龛 / Repo Vessel — a GitHub public-repository discovery site.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/build-tokens.mjs",
    "og-vocabulary": "node scripts/build-og-vocabulary.mjs",
    "og-font": "node scripts/build-og-font.mjs",
    "audit:design": "node scripts/audit-design-tokens.mjs",
    "audit:og-font": "node scripts/audit-og-font.mjs",
    "metrics": "node scripts/metrics-report.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
